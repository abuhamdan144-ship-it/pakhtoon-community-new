rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    // Checks if the user is logged in
    function isSignedIn() {
      return request.auth != null;
    }

    // Verifies that the signed-in user is the bootstrapped Admin
    function isAdmin() {
      return isSignedIn() && 
             (request.auth.token.email == 'abuhamdan144@gmail.com' || request.auth.token.email == 'admin@opc.org');
    }

    // Hardened ID validation to protect against injection attacks
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validates basic string properties
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    // Member Validation Blueprint
    function isValidMember(data) {
      return isValidString(data.name, 1, 100) &&
             isValidString(data.father, 1, 100) &&
             isValidString(data.cnic, 1, 50) &&
             isValidString(data.district, 1, 100) &&
             isValidString(data.phone, 1, 30) &&
             isValidString(data.address, 1, 500) &&
             (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
             data.createdAt != null;
    }

    // Donation Validation Blueprint
    function isValidDonation(data) {
      return isValidString(data.donor, 1, 100) &&
             (data.amount is int || data.amount is number) && data.amount >= 0 &&
             isValidString(data.date, 10, 10) &&
             (data.method == 'Bank Transfer' || data.method == 'Cash' || data.method == 'Mobile Wallet') &&
             data.createdAt != null;
    }

    // Incident Report Validation Blueprint
    function isValidIncident(data) {
      return (data.type == 'death' || data.type == 'injury' || data.type == 'loss') &&
             isValidString(data.name, 1, 100) &&
             isValidString(data.description, 1, 2000) &&
             isValidString(data.date, 10, 10) &&
             isValidString(data.contact, 1, 30) &&
             (data.status == 'pending' || data.status == 'published' || data.status == 'closed') &&
             data.createdAt != null;
    }

    // Cabinet Member Validation Blueprint
    function isValidCabinetMember(data) {
      return isValidString(data.name, 1, 100) &&
             isValidString(data.position, 1, 150);
    }

    // News/Announcement Validation Blueprint
    function isValidNews(data) {
      return isValidString(data.title, 1, 200) &&
             isValidString(data.content, 1, 10000) &&
             data.createdAt != null;
    }

    // Sponsored Ad Validation Blueprint
    function isValidAd(data) {
      return isValidString(data.name, 1, 100) &&
             isValidString(data.link, 1, 500) &&
             (data.amount is int || data.amount is number) && data.amount >= 0 &&
             isValidString(data.start, 10, 10) &&
             isValidString(data.end, 10, 10) &&
             isValidString(data.image, 1, 1500000) &&
             data.createdAt != null;
    }

    // --- COLLECTION MATCHES ---

    // Members Collection Rules
    match /members/{memberId} {
      allow create: if isValidMember(request.resource.data) && request.resource.data.status == 'pending';
      allow get: if isAdmin() || (resource == null || resource.data.status == 'approved');
      allow list: if isAdmin() || (resource != null && resource.data.status == 'approved');
      allow update, delete: if isAdmin();
    }

    // Donations Collection Rules
    match /donations/{donationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidDonation(request.resource.data);
    }

    // Cabinet Collection Rules
    match /cabinet/{cabinetId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCabinetMember(request.resource.data);
      allow delete: if isAdmin();
    }

    // News Collection Rules
    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidNews(request.resource.data);
      allow delete: if isAdmin();
    }

    // Incidents Collection Rules
    match /incidents/{incidentId} {
      allow create: if isValidIncident(request.resource.data) && request.resource.data.status == 'pending';
      allow get: if isAdmin() || (resource == null || resource.data.status == 'published');
      allow list: if isAdmin() || (resource != null && resource.data.status == 'published');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Settings Collection Rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Elections Collection Rules
    match /elections/{electionId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (resource.data.status == 'open');
      allow delete: if isAdmin();
    }

    // Users Collection Rules
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Votes Collection Rules
    match /votes/{voteId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Ads Collection Rules
    match /ads/{adId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidAd(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
